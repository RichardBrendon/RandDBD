{
  "name": "randdbd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --ssr src/index.js --outDir dist/server --emptyOutDir false",
    "preview": "vite preview",
    "build:android": "vite build --mode android",
    "android:sync": "pnpm build:android && cap sync android",
    "android:open": "cap open android",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@openai/sites-vite-plugin": "latest",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "cheerio": "^1.2.0",
    "prettier": "3.6.2"
  }
}
